# Models (pull them first: ollama pull <name>)
LLM_MODEL=qwen3:4b-instruct
EMBED_MODEL=nomic-embed-text
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval (rebuild the index after changing chunk settings: python -m src.store)
CHUNK_SIZE=100
CHUNK_OVERLAP=20
RETRIEVAL_MODE=rerank   # dense | hybrid | rerank

# Where the vector database is stored
CHROMA_PATH=data/chroma
